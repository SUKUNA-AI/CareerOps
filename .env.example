# PostgreSQL v2 control/domain target
CAREEROPS_V2_POSTGRES_DSN=postgresql://careerops_v2:password@127.0.0.1:5432/careerops_v2

# S3 / SeaweedFS
CAREEROPS_S3_ENDPOINT=http://127.0.0.1:8333
CAREEROPS_S3_ACCESS_KEY=change-me
CAREEROPS_S3_SECRET_KEY=change-me
CAREEROPS_S3_BUCKET=careerops-raw
CAREEROPS_S3_REGION=us-east-1
CAREEROPS_S3_PREFIX=_lab/hh

# HH read-only source adapter
CAREEROPS_HH_ACCOUNTS_CONFIG=/etc/careerops/hh/accounts.toml
CAREEROPS_HH_DISCOVERY_CONFIG=/srv/careerops/app/config/hh_discovery.toml
# Minimum start-to-start interval for one account's HH source requests.
CAREEROPS_HH_REQUEST_MIN_INTERVAL_SECONDS=3.0
# Re-read this many seconds behind the previous publication watermark.
CAREEROPS_HH_WATERMARK_OVERLAP_SECONDS=3600
