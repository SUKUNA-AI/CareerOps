# PostgreSQL
CAREEROPS_POSTGRES_DSN=postgresql://careerops:password@127.0.0.1:5432/careerops

# S3 / SeaweedFS
CAREEROPS_S3_ENDPOINT=http://127.0.0.1:8333
CAREEROPS_S3_ACCESS_KEY=change-me
CAREEROPS_S3_SECRET_KEY=change-me
CAREEROPS_S3_BUCKET=careerops-raw
CAREEROPS_S3_REGION=us-east-1
CAREEROPS_S3_PREFIX=_lab/hh

# HH runtime safety and non-secret configuration pointers
CAREEROPS_HH_MODE=observe
CAREEROPS_HH_ALLOW_EXTERNAL_WRITES=false
CAREEROPS_HH_ACCOUNTS_CONFIG=/etc/careerops/hh/accounts.toml
CAREEROPS_HH_DISCOVERY_CONFIG=/srv/careerops/app/config/hh_discovery.toml
CAREEROPS_HH_RESUME_REGISTRY=postgres
