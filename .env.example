# CareerOPS Freeze v1 aggregate reference.
# Canonical Compose services load their own files from /etc/careerops/*/env.

# PostgreSQL
CAREEROPS_V2_POSTGRES_DSN=postgresql://careerops:change-me@127.0.0.1:5432/careerops

# S3 / SeaweedFS
CAREEROPS_S3_ENDPOINT=http://127.0.0.1:8333
CAREEROPS_S3_ACCESS_KEY=change-me
CAREEROPS_S3_SECRET_KEY=change-me
CAREEROPS_S3_BUCKET=careerops-raw
CAREEROPS_S3_REGION=us-east-1
CAREEROPS_S3_PREFIX=_lab/hh

# Read-only HH source adapter. No scheduler is part of Freeze v1.
CAREEROPS_HH_ACCOUNTS_CONFIG=/etc/careerops/hh/accounts.toml
CAREEROPS_HH_DISCOVERY_CONFIG=/app/config/hh_discovery.toml
CAREEROPS_HH_REQUEST_MIN_INTERVAL_SECONDS=3.0
CAREEROPS_HH_WATERMARK_OVERLAP_SECONDS=3600

# Manual PySpark normalizer
CAREEROPS_NORMALIZER_RAW_BUCKET=careerops-raw
CAREEROPS_NORMALIZER_LAKE_BUCKET=careerops-lake
CAREEROPS_NORMALIZER_RAW_PREFIX=v2
CAREEROPS_NORMALIZER_RAW_STORAGE_PREFIX=_lab/hh
CAREEROPS_NORMALIZER_POSTGRES_DSN=postgresql://careerops:change-me@127.0.0.1:5432/careerops
CAREEROPS_NORMALIZER_PARTITIONS=8

# Processing v2
CAREEROPS_PROCESSING_POSTGRES_DSN=postgresql://careerops:change-me@127.0.0.1:5432/careerops
CAREEROPS_PROCESSING_S3_ENDPOINT_URL=http://127.0.0.1:8333
CAREEROPS_PROCESSING_S3_ACCESS_KEY=change-me
CAREEROPS_PROCESSING_S3_SECRET_KEY=change-me
CAREEROPS_PROCESSING_S3_REGION=us-east-1
CAREEROPS_PROCESSING_NORMALIZED_BUCKET=careerops-lake
CAREEROPS_PROCESSING_ARTIFACTS_BUCKET=careerops-artifacts
CAREEROPS_PROCESSING_ARTIFACTS_PREFIX=processing
CAREEROPS_PROCESSING_RERANKER_URL=http://127.0.0.1:18082
CAREEROPS_PROCESSING_RERANKER_TIMEOUT_SECONDS=60
CAREEROPS_PROCESSING_RERANKER_UNAVAILABLE_DELAY_SECONDS=120
CAREEROPS_PROCESSING_WORKER_ID=processing-local-1
CAREEROPS_PROCESSING_WORKER_LEASE_SECONDS=300
CAREEROPS_PROCESSING_WORKER_IDLE_SLEEP_SECONDS=1.0
CAREEROPS_PROCESSING_HEALTH_HOST=127.0.0.1
CAREEROPS_PROCESSING_HEALTH_PORT=18081

# Jina reranker
CAREEROPS_RERANKER_MODEL_ID=jinaai/jina-reranker-v3.5
CAREEROPS_RERANKER_MODEL_REVISION=e8a93f33f0b22108f8c2364f8484ce3422552fbc
CAREEROPS_RERANKER_MODEL_CODE_REVISION=e8a93f33f0b22108f8c2364f8484ce3422552fbc
CAREEROPS_RERANKER_TOKENIZER_REVISION=e8a93f33f0b22108f8c2364f8484ce3422552fbc
CAREEROPS_RERANKER_RUNTIME_BACKEND=transformers-cuda
CAREEROPS_RERANKER_DTYPE=float16
CAREEROPS_RERANKER_DEVICE=cuda
CAREEROPS_RERANKER_HOST=0.0.0.0
CAREEROPS_RERANKER_PORT=18082

# Application Owner: fail-closed parked default. Never change casually.
CAREEROPS_APPLICATION_ALLOW_EXTERNAL_WRITES=false
CAREEROPS_APPLICATION_POSTGRES_DSN=postgresql://careerops:change-me@127.0.0.1:5432/careerops
CAREEROPS_APPLICATION_HH_CONFIG_DIR=/var/lib/careerops/hh-applicant-tool
CAREEROPS_APPLICATION_S3_BUCKET=careerops-artifacts
CAREEROPS_APPLICATION_S3_PREFIX=application-owner
CAREEROPS_APPLICATION_HEALTH_HOST=127.0.0.1
CAREEROPS_APPLICATION_HEALTH_PORT=18083
