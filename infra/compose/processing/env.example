# Скопировать в /etc/careerops/processing/env на core
# Реальные credentials в репозиторий не добавлять

CAREEROPS_PROCESSING_POSTGRES_DSN=postgresql://careerops:REPLACE_ME@192.168.0.10:5432/careerops
CAREEROPS_PROCESSING_S3_ENDPOINT_URL=http://192.168.0.10:8333
CAREEROPS_PROCESSING_S3_ACCESS_KEY=REPLACE_ME
CAREEROPS_PROCESSING_S3_SECRET_KEY=REPLACE_ME
CAREEROPS_PROCESSING_S3_REGION=us-east-1
CAREEROPS_PROCESSING_NORMALIZED_BUCKET=careerops-lake
CAREEROPS_PROCESSING_ARTIFACTS_BUCKET=careerops-artifacts
CAREEROPS_PROCESSING_ARTIFACTS_PREFIX=processing
CAREEROPS_PROCESSING_RERANKER_URL=http://192.168.0.10:18082
CAREEROPS_PROCESSING_RERANKER_TIMEOUT_SECONDS=60
CAREEROPS_PROCESSING_RERANKER_UNAVAILABLE_DELAY_SECONDS=120
CAREEROPS_PROCESSING_WORKER_ID=core-processing-1
CAREEROPS_PROCESSING_WORKER_LEASE_SECONDS=300
CAREEROPS_PROCESSING_WORKER_IDLE_SLEEP_SECONDS=1.0
CAREEROPS_PROCESSING_HEALTH_HOST=127.0.0.1
CAREEROPS_PROCESSING_HEALTH_PORT=18081