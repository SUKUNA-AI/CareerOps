CAREEROPS_APPLICATION_POSTGRES_DSN=postgresql://careerops:change-me@127.0.0.1:5432/careerops
CAREEROPS_APPLICATION_HH_CONFIG_DIR=/var/lib/careerops/hh-applicant-tool
CAREEROPS_APPLICATION_WORKER_ID=core-application-owner-01
CAREEROPS_APPLICATION_POLL_SECONDS=2
CAREEROPS_APPLICATION_LEASE_SECONDS=120
CAREEROPS_APPLICATION_RETRY_SECONDS=900
CAREEROPS_APPLICATION_RECONCILE_SECONDS=120
CAREEROPS_APPLICATION_TRANSPORT_TIMEOUT_SECONDS=45
CAREEROPS_APPLICATION_OPERATION_TIMEOUT_SECONDS=90
CAREEROPS_APPLICATION_MAX_RECONCILIATION_BURST=8
CAREEROPS_APPLICATION_ACCOUNT_LIMIT_COOLDOWN_SECONDS=900
CAREEROPS_APPLICATION_HEALTH_HOST=127.0.0.1
CAREEROPS_APPLICATION_HEALTH_PORT=18083
CAREEROPS_APPLICATION_S3_BUCKET=careerops-artifacts
CAREEROPS_APPLICATION_S3_PREFIX=application-owner
CAREEROPS_S3_ENDPOINT=http://127.0.0.1:8333
CAREEROPS_S3_ACCESS_KEY=change-me
CAREEROPS_S3_SECRET_KEY=change-me
CAREEROPS_S3_REGION=us-east-1
# Optional. Required only for vacancies that require a cover letter.
CAREEROPS_APPLICATION_COVER_LETTER=
