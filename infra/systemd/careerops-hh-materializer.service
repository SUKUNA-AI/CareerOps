[Unit]
Description=CareerOPS HH S3 RAW to PostgreSQL materializer
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=sukuna
Group=sukuna
WorkingDirectory=/srv/careerops/app
EnvironmentFile=-/etc/careerops/hh/env
EnvironmentFile=-/etc/careerops/hh/scheduler.env
ExecStart=/srv/careerops/app/.venv/bin/python /srv/careerops/app/scripts/materialize_hh_pending.py --limit 10
