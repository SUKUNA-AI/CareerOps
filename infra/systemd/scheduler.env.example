# Non-secret CareerOPS HH scheduler settings.
CAREEROPS_HH_MODE=observe
CAREEROPS_HH_ALLOW_EXTERNAL_WRITES=false
CAREEROPS_HH_ACCOUNTS_CONFIG=/etc/careerops/hh/accounts.toml
CAREEROPS_HH_DISCOVERY_CONFIG=/srv/careerops/app/config/hh_discovery.toml
CAREEROPS_HH_RESUME_REGISTRY=postgres
CAREEROPS_HH_TIMEZONE=Europe/Moscow
CAREEROPS_HH_WINDOW_START=08:30
CAREEROPS_HH_WINDOW_END=23:00
CAREEROPS_HH_MIN_GAP_MINUTES=60
CAREEROPS_HH_LATE_GRACE_MINUTES=75
CAREEROPS_HH_STATE_DIR=/var/lib/careerops/hh
CAREEROPS_ROOT=/srv/careerops/app
